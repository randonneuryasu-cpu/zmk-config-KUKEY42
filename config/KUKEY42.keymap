#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 5>;
            key-positions = <19 20>;
        };

        Rtshift {
            bindings = <&kp RSHIFT>;
            key-positions = <18 19>;
        };

        Rtwin {
            bindings = <&kp RGUI>;
            key-positions = <19 20>;
        };

        RtAlt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <17 18>;
        };

        Rtctl {
            bindings = <&kp RCTRL>;
            key-positions = <20 21>;
        };

        Ltshift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <13 14>;
        };

        Ltwin {
            bindings = <&kp LCMD>;
            key-positions = <11 12>;
        };

        LtAlt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <14 13>;
        };

        Ltctl {
            bindings = <&kp LCTRL>;
            key-positions = <10 11>;
        };

        RtMB2 {
            bindings = <&mkp MB2>;
            key-positions = <7 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tapdance_kana: tapdance_kana {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE_KANA";
            #binding-cells = <0>;
            bindings = <&kp INT2>, <&kp LANGUAGE_2>, <&sl 1>;

            tapping-term-ms = <400>;
        };

        WheelScroll: WheelScroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "WHEELSCROLL";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W             &kp F          &kp P       &kp B                                              &kp J        &kp L  &kp U      &kp Y    &kp SEMICOLON
&kp A        &kp R             &kp S          &kp T       &kp G             &mkp MCLK          &out OUT_BLE  &kp M        &kp N  &kp E      &kp I    &kp O
&kp Z        &kp X             &kp C          &kp D       &kp V             &kp LC(SPACE)      &out OUT_USB  &kp K        &kp H  &kp COMMA  &kp DOT  &kp SLASH
&kp LC(F10)  &kp SINGLE_QUOTE  &kp LG(SPACE)  &kp DELETE  &lt 1 DOWN_ARROW  &lt 2 ENTER        &kp TAB       &lt 3 SPACE                             &kp EXCLAMATION
            >;

            sensor-bindings = <&WheelScroll SCRL_DOWN SCRL_UP>;
        };

        FUNCTION {
            bindings = <
&kp LA(UP_ARROW)    &kp HOME        &kp UP_ARROW    &kp END           &kp LA(DOWN_ARROW)                         &kp MINUS      &kp N7        &kp N8        &kp N9        &trans
&kp LC(LEFT_ARROW)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT         &kp LC(RIGHT)       &trans      &trans     &kp N0         &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SINGLE_QUOTE
&kp F12             &kp F11         &kp LA(C)       &kp LG(UP_ARROW)  &kp LS(LC(V))       &trans      &trans     &kp EQUAL      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
&kp F2              &kp F9          &trans          &trans            &trans              &trans      &kp ENTER  &kp BACKSPACE                                            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUM {
            bindings = <
&kp LC(UP_ARROW)    &kp HOME        &kp UP_ARROW        &kp END           &kp RA(DOWN_ARROW)                         &kp F12            &kp F7  &kp F8  &kp F9  &kp LEFT_PARENTHESIS
&kp RC(LEFT_ARROW)  &kp LEFT_ARROW  &kp DOWN_ARROW      &kp RIGHT         &kp RC(RIGHT)       &trans      &trans     &kp F11            &kp F4  &kp F5  &kp F6  &kp RIGHT_PARENTHESIS
&kp F12             &kp F11         &kp LS(LC(C))       &kp LG(UP_ARROW)  &kp LC(LS(V))       &trans      &trans     &kp F10            &kp F1  &kp F2  &kp F3  &kp LEFT_BRACKET
&kp F2              &kp F9          &kp LG(DOWN_ARROW)  &trans            &trans              &trans      &kp ENTER  &kp RC(BACKSPACE)                          &lt 6 RIGHT_BRACKET
            >;
        };

        ARROW {
            bindings = <
&kp AMPERSAND        &kp AT_SIGN       &kp RIGHT_BRACKET  &kp BACKSLASH  &kp LS(INTERNATIONAL_3)                             &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN
&kp MINUS            &kp LEFT_BRACKET  &kp EXCLAMATION    &kp QUESTION   &kp INT_YEN              &trans             &trans  &kp F11  &kp F4  &kp F5  &kp F6  &kp ESCAPE
&mt LEFT_SHIFT HASH  &kp PERCENT       &kp SINGLE_QUOTE   &kp SEMICOLON  &kp EQUAL                &kp LG(SPACE)      &trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp DELETE
&trans               &trans            &trans             &trans         &trans                   &trans             &trans  &trans                           &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(KP_MINUS) LC(KP_PLUS)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &to 0   &trans  &mkp MB1  &mo 5   &mkp MB2  &mkp MB3
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &bootloader
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        BT {
            bindings = <
&trans       &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans       &trans        &trans        &trans        &trans  &trans      &sys_reset   &trans        &trans        &trans        &trans        &trans
&trans       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&bootloader  &sys_reset    &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
